# Python bytecode and caches
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# Build and packaging output (dist/ also holds the built UI page)
build/
dist/
*.egg-info/

# Rust build output (ui/src-tauri/)
target/

# Test and coverage leftovers
.pytest_cache/
.coverage
htmlcov/

# Tool caches
.mypy_cache/
.ruff_cache/

# Editor swap and backup files
*.swp
*~

# Local environment files
.env

# Logs that setup and tools write beside the code (setup.log, verify_env.log, fetch_models.log)
*.log

# IDE configuration (local machine-specific)
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# OS artifacts
.DS_Store
Thumbs.db

# BetaSuite runtime outputs (local machine-specific)
# Keep directory structure for examples, ignore contents
output/
cache/
*.log.json

# Generated by betabench structure (lives in output/ by default; this guards a copy in the repo)
/moves.sh

# Local test runs (transient)
run_keys/
**/.pytest_cache/
**/.coverage
tools/release/release-notes.md

# Your own settings (CONFIG_REFERENCE.md, "Local config"), and the editor's
# temporary file while it writes one
/betaconfig_local.py
/.betaconfig_local.py.*.tmp

# Claude Code: per-milestone worktrees and this machine's session settings
/.claude/worktrees/
/.claude/settings.local.json

# Desktop UI (ui/): npm packages and the schemas Tauri regenerates on every
# build (the built page and Rust output fall under dist/ and target/ above)
node_modules/
/ui/src-tauri/gen/
