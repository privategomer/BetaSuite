{
  "name": "betasuite-ui",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "check": "npm run lint && npm run typecheck && npm run catalog:check && npm run catalog:selftest && npm run settings:reach && npm run settings:reach:selftest && npm run contrast:check",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build --no-bundle",
    "catalog:check": "node scripts/check-catalog.mjs",
    "catalog:selftest": "node scripts/check-catalog.selftest.mjs",
    "settings:reach": "node scripts/check-settings-reach.mjs",
    "settings:reach:selftest": "node scripts/check-settings-reach.selftest.mjs",
    "contrast:check": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.12.5",
    "intl-messageformat": "~12.2.1",
    "react": "~19.3.1",
    "react-dom": "~19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@formatjs/icu-messageformat-parser": "~3.5.23",
    "@tauri-apps/cli": "~2.12.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.3.0",
    "eslint": "~10.15.0",
    "eslint-plugin-jsx-a11y-x": "~0.2.0",
    "eslint-plugin-react-hooks": "~7.1.1",
    "globals": "~17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.74.0",
    "vite": "~8.3.8"
  }
}
