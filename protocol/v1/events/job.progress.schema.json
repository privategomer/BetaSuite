{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betasuite.invalid/protocol/v1/events/job.progress.schema.json",
  "title": "job.progress",
  "description": "How far a stage of a file has got: detect (per detection size, size), persons (reverse mode's person masks) or render. done and total count samples for detect and persons, frames for render; total is null when unknown. rate is done per second over this run of the stage. Coalesced: at most a few per second per job, the latest of each stage, so one can be dropped, never reordered past another event.",
  "$defs": {
    "data": {
      "type": "object",
      "required": [
        "job",
        "file",
        "stage",
        "done",
        "total",
        "rate"
      ],
      "properties": {
        "job": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "integer",
          "minimum": 0
        },
        "stage": {
          "enum": [
            "detect",
            "persons",
            "render"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "done": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "rate": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
