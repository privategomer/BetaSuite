{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betasuite.invalid/protocol/v1/events/job.state.schema.json",
  "title": "job.state",
  "description": "A job changed state: queued (sent after job.submit's result), running, paused, or one of the final states completed, cancelled and stopped. A job's last event is its final state. A stopped job carries code and params, an error code from errors.schema.json: disk.full, model.load_failed, config.invalid, job.unsafe_setting, job.nothing_to_render, engine.stopping (the engine shut down; checkpoints are kept) or engine.internal. counts are the job's files so far.",
  "$defs": {
    "data": {
      "type": "object",
      "required": [
        "job",
        "state",
        "counts"
      ],
      "properties": {
        "job": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "paused",
            "completed",
            "cancelled",
            "stopped"
          ]
        },
        "counts": {
          "type": "object",
          "required": [
            "total",
            "processed",
            "skipped",
            "failed"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "processed": {
              "type": "integer",
              "minimum": 0
            },
            "skipped": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "code": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      },
      "dependentRequired": {
        "code": [
          "params"
        ],
        "params": [
          "code"
        ]
      }
    }
  }
}
