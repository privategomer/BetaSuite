{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betasuite.invalid/protocol/v1/commands/hello.schema.json",
  "title": "hello",
  "description": "The handshake, and the first command of a session. The client offers the protocol versions it speaks; the engine picks the highest in common and describes itself. A failed hello answers protocol.unsupported_version or command.bad_params.",
  "$defs": {
    "data": {
      "type": "object",
      "required": [ "protocol" ],
      "properties": {
        "protocol": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
        "client": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "required": [ "protocol", "engine", "pid", "commands", "events", "limits" ],
      "properties": {
        "protocol": { "type": "integer", "minimum": 1 },
        "engine": {
          "type": "object",
          "required": [ "version", "python", "platform" ],
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "python": { "type": "string", "minLength": 1 },
            "platform": { "type": "string", "minLength": 1 }
          }
        },
        "pid": { "type": "integer", "minimum": 1 },
        "commands": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "events": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "limits": {
          "type": "object",
          "required": [ "max_line_bytes" ],
          "properties": {
            "max_line_bytes": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
