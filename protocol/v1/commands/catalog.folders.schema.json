{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betasuite.invalid/protocol/v1/commands/catalog.folders.schema.json",
  "title": "catalog.folders",
  "description": "The watched folders: id, path, whether its folder names pick the video type (type_from_folder), whether it can be read now (available), and how many items it holds.",
  "$defs": {
    "data": {
      "type": "object"
    },
    "result": {
      "type": "object",
      "required": [
        "folders"
      ],
      "properties": {
        "folders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "folder",
              "path",
              "type_from_folder",
              "available",
              "items"
            ],
            "properties": {
              "folder": {
                "type": "integer"
              },
              "path": {
                "type": "string"
              },
              "type_from_folder": {
                "type": "boolean"
              },
              "available": {
                "type": "boolean"
              },
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
