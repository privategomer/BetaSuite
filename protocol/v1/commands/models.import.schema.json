{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betasuite.invalid/protocol/v1/commands/models.import.schema.json",
  "title": "models.import",
  "description": "\"I already have the file\": install the file at path when its SHA-256 is a catalog model's. The file is copied, never moved. model.unknown_file when it matches no model.",
  "$defs": {
    "data": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
