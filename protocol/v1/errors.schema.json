{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betasuite.invalid/protocol/v1/errors.schema.json",
  "title": "error",
  "description": "The error of a failed result: a code and exactly the parameters that code lists. Never a sentence; the UI owns the wording.",
  "type": "object",
  "required": [ "code", "params" ],
  "properties": {
    "code": { "type": "string" },
    "params": { "type": "object" }
  },
  "oneOf": [
    { "$ref": "#/$defs/protocol.bad_encoding" },
    { "$ref": "#/$defs/protocol.bad_json" },
    { "$ref": "#/$defs/protocol.line_too_long" },
    { "$ref": "#/$defs/protocol.bad_envelope" },
    { "$ref": "#/$defs/protocol.unsupported_version" },
    { "$ref": "#/$defs/protocol.hello_required" },
    { "$ref": "#/$defs/command.unknown" },
    { "$ref": "#/$defs/command.bad_params" },
    { "$ref": "#/$defs/engine.internal" },
    { "$ref": "#/$defs/config.bad_type" },
    { "$ref": "#/$defs/config.out_of_range" },
    { "$ref": "#/$defs/config.bad_choice" },
    { "$ref": "#/$defs/config.rule" },
    { "$ref": "#/$defs/config.invalid" },
    { "$ref": "#/$defs/config.unknown_key" },
    { "$ref": "#/$defs/config.not_settable" },
    { "$ref": "#/$defs/config.local_off" },
    { "$ref": "#/$defs/config.local_unparsable" },
    { "$ref": "#/$defs/config.local_unwritable" },
    { "$ref": "#/$defs/run.locked" },
    { "$ref": "#/$defs/config.busy" },
    { "$ref": "#/$defs/job.unknown" },
    { "$ref": "#/$defs/job.bad_state" },
    { "$ref": "#/$defs/job.no_such_file" },
    { "$ref": "#/$defs/job.unsafe_setting" },
    { "$ref": "#/$defs/job.nothing_to_render" },
    { "$ref": "#/$defs/engine.stopping" },
    { "$ref": "#/$defs/file.failed" },
    { "$ref": "#/$defs/disk.full" },
    { "$ref": "#/$defs/model.load_failed" }
  ],
  "$defs": {
    "reason": { "enum": [ "missing", "type", "value" ] },
    "protocol.bad_encoding": {
      "description": "A line was not UTF-8.",
      "properties": {
        "code": { "const": "protocol.bad_encoding" },
        "params": { "type": "object", "required": [], "properties": {}, "additionalProperties": false }
      }
    },
    "protocol.bad_json": {
      "description": "A line was not one JSON value.",
      "properties": {
        "code": { "const": "protocol.bad_json" },
        "params": { "type": "object", "required": [], "properties": {}, "additionalProperties": false }
      }
    },
    "protocol.line_too_long": {
      "description": "A line was longer than limit_bytes (hello reports it) and was discarded.",
      "properties": {
        "code": { "const": "protocol.line_too_long" },
        "params": {
          "type": "object",
          "required": [ "limit_bytes", "line_bytes" ],
          "properties": {
            "limit_bytes": { "type": "integer", "minimum": 1 },
            "line_bytes": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      }
    },
    "protocol.bad_envelope": {
      "description": "A JSON line was not a well-formed command. field names the envelope field, or 'message' when the line was not an object.",
      "properties": {
        "code": { "const": "protocol.bad_envelope" },
        "params": {
          "type": "object",
          "required": [ "field", "reason" ],
          "properties": {
            "field": { "enum": [ "message", "v", "kind", "id", "name", "data" ] },
            "reason": { "$ref": "#/$defs/reason" }
          },
          "additionalProperties": false
        }
      }
    },
    "protocol.unsupported_version": {
      "description": "No protocol version in common. got is what the client sent: the envelope's v, or hello's protocol list.",
      "properties": {
        "code": { "const": "protocol.unsupported_version" },
        "params": {
          "type": "object",
          "required": [ "got", "supported" ],
          "properties": {
            "got": {},
            "supported": { "type": "array", "items": { "type": "integer" } }
          },
          "additionalProperties": false
        }
      }
    },
    "protocol.hello_required": {
      "description": "A command other than hello or shutdown came before a successful hello.",
      "properties": {
        "code": { "const": "protocol.hello_required" },
        "params": {
          "type": "object",
          "required": [ "name" ],
          "properties": { "name": { "type": "string" } },
          "additionalProperties": false
        }
      }
    },
    "command.unknown": {
      "description": "No command by this name. hello lists the ones there are.",
      "properties": {
        "code": { "const": "command.unknown" },
        "params": {
          "type": "object",
          "required": [ "name" ],
          "properties": { "name": { "type": "string" } },
          "additionalProperties": false
        }
      }
    },
    "command.bad_params": {
      "description": "A command's data was missing a field, or had one of the wrong type or value.",
      "properties": {
        "code": { "const": "command.bad_params" },
        "params": {
          "type": "object",
          "required": [ "field", "reason" ],
          "properties": {
            "field": { "type": "string" },
            "reason": { "$ref": "#/$defs/reason" }
          },
          "additionalProperties": false
        }
      }
    },
    "engine.internal": {
      "description": "The engine failed while handling the command and keeps serving. The traceback is in the engine log.",
      "properties": {
        "code": { "const": "engine.internal" },
        "params": {
          "type": "object",
          "required": [ "exception_type" ],
          "properties": { "exception_type": { "type": "string" } },
          "additionalProperties": false
        }
      }
    },
    "config.bad_type": {
      "description": "A value is the wrong kind. path is the dotted setting path; expected is its registry kind (int, number, bool, choice, ...).",
      "properties": {
        "code": { "const": "config.bad_type" },
        "params": {
          "type": "object",
          "required": [ "path", "expected" ],
          "properties": { "path": { "type": "string" }, "expected": { "type": "string" } },
          "additionalProperties": false
        }
      }
    },
    "config.out_of_range": {
      "description": "A number is outside its range. minimum or maximum is null where there is no bound; min_open and max_open say that bound itself is excluded; odd says the number must be odd.",
      "properties": {
        "code": { "const": "config.out_of_range" },
        "params": {
          "type": "object",
          "required": [ "path", "minimum", "maximum", "min_open", "max_open", "odd" ],
          "properties": {
            "path": { "type": "string" },
            "minimum": { "type": [ "number", "null" ] },
            "maximum": { "type": [ "number", "null" ] },
            "min_open": { "type": "boolean" },
            "max_open": { "type": "boolean" },
            "odd": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      }
    },
    "config.bad_choice": {
      "description": "A value is not one of its choices.",
      "properties": {
        "code": { "const": "config.bad_choice" },
        "params": {
          "type": "object",
          "required": [ "path", "choices" ],
          "properties": { "path": { "type": "string" }, "choices": { "type": "array" } },
          "additionalProperties": false
        }
      }
    },
    "config.rule": {
      "description": "A check between values, or of a structure, failed. rule is a stable id (area.what); path is the setting it is about, or empty.",
      "properties": {
        "code": { "const": "config.rule" },
        "params": {
          "type": "object",
          "required": [ "rule", "path" ],
          "properties": {
            "rule": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
            "path": { "type": "string" }
          },
          "additionalProperties": false
        }
      }
    },
    "config.invalid": {
      "description": "A change was not made because the result would fail validation. Each problem is a config.bad_type, config.out_of_range, config.bad_choice or config.rule error.",
      "properties": {
        "code": { "const": "config.invalid" },
        "params": {
          "type": "object",
          "required": [ "problems" ],
          "properties": {
            "problems": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [ "code", "params" ],
                "oneOf": [
                  { "$ref": "#/$defs/config.bad_type" },
                  { "$ref": "#/$defs/config.out_of_range" },
                  { "$ref": "#/$defs/config.bad_choice" },
                  { "$ref": "#/$defs/config.rule" }
                ]
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "config.unknown_key": {
      "description": "No setting has this path. suggestion is the closest real path, or null.",
      "properties": {
        "code": { "const": "config.unknown_key" },
        "params": {
          "type": "object",
          "required": [ "path", "suggestion" ],
          "properties": { "path": { "type": "string" }, "suggestion": { "type": [ "string", "null" ] } },
          "additionalProperties": false
        }
      }
    },
    "config.not_settable": {
      "description": "The path is inside a value that is set whole (a censor style, a rule list); setting is that value's path.",
      "properties": {
        "code": { "const": "config.not_settable" },
        "params": {
          "type": "object",
          "required": [ "path", "setting" ],
          "properties": { "path": { "type": "string" }, "setting": { "type": "string" } },
          "additionalProperties": false
        }
      }
    },
    "config.local_off": {
      "description": "The local config is turned off (BETASUITE_LOCAL_CONFIG=none), so nothing can be written.",
      "properties": {
        "code": { "const": "config.local_off" },
        "params": { "type": "object", "required": [], "properties": {}, "additionalProperties": false }
      }
    },
    "config.local_unparsable": {
      "description": "The local config file does not parse, so it cannot be edited safely; nothing was written.",
      "properties": {
        "code": { "const": "config.local_unparsable" },
        "params": { "type": "object", "required": [], "properties": {}, "additionalProperties": false }
      }
    },
    "config.local_unwritable": {
      "description": "The local config file could not be written. reason is the error's name, such as EACCES.",
      "properties": {
        "code": { "const": "config.local_unwritable" },
        "params": {
          "type": "object",
          "required": [ "reason" ],
          "properties": { "reason": { "type": "string" } },
          "additionalProperties": false
        }
      }
    },
    "run.locked": {
      "description": "Another run (the command line or the engine) holds this library's run lock, so this one did not start. A param is null when the holder's record could not be read.",
      "properties": {
        "code": { "const": "run.locked" },
        "params": {
          "type": "object",
          "required": [ "program", "pid", "started_at" ],
          "properties": {
            "program": { "type": [ "string", "null" ], "description": "betatv, betastare, engine or migrate" },
            "pid": { "type": [ "integer", "null" ] },
            "started_at": { "type": [ "number", "null" ], "description": "Epoch seconds." }
          },
          "additionalProperties": false
        }
      }
    },
    "config.busy": {
      "description": "A job is queued, running or paused, so the settings were not changed (config.set, config.reset) or not checked with overrides (config.get). job is the job holding the queue.",
      "properties": {
        "code": { "const": "config.busy" },
        "params": {
          "type": "object",
          "required": [ "job" ],
          "properties": { "job": { "type": "string" } },
          "additionalProperties": false
        }
      }
    },
    "job.unknown": {
      "description": "No job has this id, or it ended long enough ago to be forgotten.",
      "properties": {
        "code": { "const": "job.unknown" },
        "params": {
          "type": "object",
          "required": [ "job" ],
          "properties": { "job": { "type": "string" } },
          "additionalProperties": false
        }
      }
    },
    "job.bad_state": {
      "description": "The job is not in a state this command applies to: pause needs a running job, resume a paused one, cancel one that has not ended. state is the job's state.",
      "properties": {
        "code": { "const": "job.bad_state" },
        "params": {
          "type": "object",
          "required": [ "job", "state" ],
          "properties": { "job": { "type": "string" }, "state": { "enum": [ "queued", "running", "paused", "completed", "cancelled", "stopped" ] } },
          "additionalProperties": false
        }
      }
    },
    "job.no_such_file": {
      "description": "A chosen file does not exist or is not a file. index is its place in files, from 0.",
      "properties": {
        "code": { "const": "job.no_such_file" },
        "params": {
          "type": "object",
          "required": [ "index" ],
          "properties": { "index": { "type": "integer", "minimum": 0 } },
          "additionalProperties": false
        }
      }
    },
    "job.unsafe_setting": {
      "description": "The settings this job would run with include one the engine will not run unattended. path names it: input_delete_probability above 0 deletes sources, which the command line asks about first.",
      "properties": {
        "code": { "const": "job.unsafe_setting" },
        "params": {
          "type": "object",
          "required": [ "path" ],
          "properties": { "path": { "type": "string" } },
          "additionalProperties": false
        }
      }
    },
    "job.nothing_to_render": {
      "description": "The settings this job would run with censor nothing, so it would change no frame.",
      "properties": {
        "code": { "const": "job.nothing_to_render" },
        "params": {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": false
        }
      }
    },
    "engine.stopping": {
      "description": "The engine is shutting down: a job.submit refused, or the code of a job stopped by the shutdown, with its checkpoints kept.",
      "properties": {
        "code": { "const": "engine.stopping" },
        "params": {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": false
        }
      }
    },
    "file.failed": {
      "description": "One file of a job failed; the job went on with the next. exception_type is the failure's Python type, never its message. stage is where it was: prepare, detect, persons or render.",
      "properties": {
        "code": { "const": "file.failed" },
        "params": {
          "type": "object",
          "required": [ "exception_type", "stage" ],
          "properties": { "exception_type": { "type": "string" }, "stage": { "enum": [ "prepare", "detect", "persons", "render" ] } },
          "additionalProperties": false
        }
      }
    },
    "disk.full": {
      "description": "A disk filled, so the job, and every job queued after it, stopped. Finished outputs are kept and skipped next time; the file that failed is rebuilt. free_bytes is the space left in the output folder, or null when it could not be read.",
      "properties": {
        "code": { "const": "disk.full" },
        "params": {
          "type": "object",
          "required": [ "free_bytes" ],
          "properties": { "free_bytes": { "type": [ "integer", "null" ], "minimum": 0 } },
          "additionalProperties": false
        }
      }
    },
    "model.load_failed": {
      "description": "The detection model did not load, so the job stopped before its first file. exception_type is the failure's Python type.",
      "properties": {
        "code": { "const": "model.load_failed" },
        "params": {
          "type": "object",
          "required": [ "exception_type" ],
          "properties": { "exception_type": { "type": "string" } },
          "additionalProperties": false
        }
      }
    }
  }
}
